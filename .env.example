# --- App ---
# PostgreSQL is required (no SQLite). Defaults match docker-compose.yml.
DATABASE_URL=postgresql://smartreco:smartreco@localhost:5432/smartreco
SECRET_KEY=change-me-in-local-env
APP_ENV=development

# --- Mesh API (mandatory for ALL LLM/AI calls) ---
# Create a key at https://api.meshapi.ai (starts with rsk_)
MESH_API_KEY=rsk_replace_me
MESH_BASE_URL=https://api.meshapi.ai/v1
LLM_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small
# Cheap model for the behavior-analysis step (final narrative uses LLM_MODEL)
ANALYSIS_MODEL=minimax/m2-her

# --- Agent engine ---
MIN_EVENTS_THRESHOLD=3
MIN_RECO_RUN_INTERVAL_MINUTES=30
RECO_VALIDITY_MINUTES=60
AGENT_MAX_REFINE_LOOPS=2
AGENT_MAX_GENERATE_RETRIES=2

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=smartreco
PINECONE_DIMENSION=1536
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Scheduler (bonus) ---
DIGEST_TIME=09:00
DIGEST_TIMEZONE=Asia/Kolkata

# --- SMTP (bonus: proactive email delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
