# --- App ---
# Postgres (production default). If unset, falls back to SQLite for a quick local run.
DATABASE_URL=postgresql://smartreco:smartreco@localhost:5432/smartreco
SECRET_KEY=change-me-in-local-env
APP_ENV=development

# --- Mesh API (mandatory for ALL LLM/AI calls) ---
# Create a key at https://api.meshapi.ai (starts with rsk_)
MESH_API_KEY=rsk_replace_me
MESH_BASE_URL=https://api.meshapi.ai/v1
LLM_MODEL=openai/gpt-4o
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=smartreco
PINECONE_DIMENSION=1536

# --- Scheduler (bonus) ---
DIGEST_TIME=09:00
DIGEST_TIMEZONE=Asia/Kolkata

# --- SMTP (bonus: proactive email delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
